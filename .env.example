# ---------------------------------------------------------------
# Copy this file to `.env.local` and fill in your real values.
# `.env.local` is git-ignored — your secrets will never be committed.
# ---------------------------------------------------------------

# Gmail address that sends every email (its inbox is also read by the site)
GMAIL_USER=your-email@gmail.com

# 16-character Gmail App Password (NOT your normal Gmail password).
# Create one at https://myaccount.google.com/apppasswords (needs 2-step verification).
GMAIL_APP_PASSWORD=your-16-character-app-password

# The inbox that receives every registration and submission.
RECEIVER_EMAIL=receiver@example.com

# Login for the organizer panel at /admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Signs admin sessions and approval links. Any long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Optional, local testing only: send mail through a fake SMTP server instead of Gmail.
# Leave these unset on Vercel.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
