# ---------------------------------------------------------------
# Copy this file to `.env.local` and fill in your real values.
# `.env.local` is git-ignored — your secrets will never be committed.
# On Vercel, add the same variables under Project → Settings → Environment Variables.
# ---------------------------------------------------------------

# --- Database (required) ----------------------------------------
# Supabase → Project → Connect → "Session pooler" connection string (IPv4, port 5432).
# URL-encode special characters in the password ($ → %24, @ → %40, # → %23).
# Don't use the transaction pooler (port 6543) or the direct connection (IPv6 only).
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Admin dashboard (required) ---------------------------------
# /admin stays locked until all three are set.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Email (optional — add when ready) --------------------------
# Until one of these is set, the site still works: registrations and decisions
# are saved, and the dashboard lets you send the pending emails later.
# Option A: any SMTP provider
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=competition@example.com
# Option B: a Gmail account with an App Password (https://myaccount.google.com/apppasswords)
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-16-character-app-password

# Inbox that gets a copy of every registration and submission (optional).
# RECEIVER_EMAIL=organizer@example.com
